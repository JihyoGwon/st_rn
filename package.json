{
  "name": "sillytavern",
  "version": "1.15.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start": "npm run start --workspace=apps/server",
    "start:mobile": "npm run start --workspace=apps/mobile",
    "start:electron": "npm run start --workspace=apps/electron",
    "test": "npm run test --workspace=apps/tests",
    "lint": "npm run lint --workspace=apps/server",
    "lint:fix": "npm run lint:fix --workspace=apps/server",
    "plugins:update": "npm run plugins:update --workspace=apps/server",
    "plugins:install": "npm run plugins:install --workspace=apps/server"
  },
  "engines": {
    "node": ">= 18"
  },
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/SillyTavern/SillyTavern.git"
  }
}
